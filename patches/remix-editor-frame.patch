+  int RemixNativeRuntime::configureEditorFrame(EditorSharedFrame& frame) {
+    if (!isInitialized() || frame.version != 1 || frame.width < 16 || frame.height < 16 ||
+        frame.width > 8192 || frame.height > 8192 || m_editorImage != nullptr) return -1;
+    auto vk = m_device->vkd();
+    auto device = vk->device();
+    auto memoryFd = reinterpret_cast<PFN_vkGetMemoryFdKHR>(vkGetDeviceProcAddr(device, "vkGetMemoryFdKHR"));
+    auto semaphoreFd = reinterpret_cast<PFN_vkGetSemaphoreFdKHR>(vkGetDeviceProcAddr(device, "vkGetSemaphoreFdKHR"));
+    if (!memoryFd || !semaphoreFd) return -2;
+    VkExternalMemoryImageCreateInfo external = { VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO };
+    external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    VkImageCreateInfo image = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    image.pNext = &external;
+    image.imageType = VK_IMAGE_TYPE_2D;
+    image.format = VK_FORMAT_R8G8B8A8_UNORM;
+    image.extent = { frame.width, frame.height, 1 };
+    image.mipLevels = 1; image.arrayLayers = 1; image.samples = VK_SAMPLE_COUNT_1_BIT;
+    image.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    if (vk->vkCreateImage(device, &image, nullptr, &m_editorNativeImage) != VK_SUCCESS) return -3;
+    VkMemoryRequirements requirements;
+    vk->vkGetImageMemoryRequirements(device, m_editorNativeImage, &requirements);
+    auto properties = m_device->adapter()->memoryProperties();
+    frame.memory_type = UINT32_MAX;
+    for (uint32_t i = 0; i < properties.memoryTypeCount; ++i)
+      if ((requirements.memoryTypeBits & (1u << i)) && (properties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) { frame.memory_type = i; break; }
+    if (frame.memory_type == UINT32_MAX) return -4;
+    frame.allocation_size = requirements.size;
+    VkExportMemoryAllocateInfo exports = { VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO };
+    exports.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    VkMemoryDedicatedAllocateInfo dedicated = { VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO };
+    dedicated.pNext = &exports; dedicated.image = m_editorNativeImage;
+    VkMemoryAllocateInfo allocation = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    allocation.pNext = &dedicated; allocation.allocationSize = requirements.size; allocation.memoryTypeIndex = frame.memory_type;
+    if (vk->vkAllocateMemory(device, &allocation, nullptr, &m_editorMemory) != VK_SUCCESS ||
+        vk->vkBindImageMemory(device, m_editorNativeImage, m_editorMemory, 0) != VK_SUCCESS) return -5;
+    VkExportSemaphoreCreateInfo exportSemaphore = { VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO };
+    exportSemaphore.handleTypes = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT;
+    VkSemaphoreCreateInfo semaphore = { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    semaphore.pNext = &exportSemaphore;
+    if (vk->vkCreateSemaphore(device, &semaphore, nullptr, &m_editorReady) != VK_SUCCESS ||
+        vk->vkCreateSemaphore(device, &semaphore, nullptr, &m_editorReleased) != VK_SUCCESS) return -6;
+    VkMemoryGetFdInfoKHR memoryInfo = { VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR };
+    memoryInfo.memory = m_editorMemory; memoryInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    VkSemaphoreGetFdInfoKHR semaphoreInfo = { VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR };
+    semaphoreInfo.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT;
+    if (memoryFd(device, &memoryInfo, &frame.memory_fd) != VK_SUCCESS) return -7;
+    semaphoreInfo.semaphore = m_editorReady;
+    if (semaphoreFd(device, &semaphoreInfo, &frame.ready_fd) != VK_SUCCESS) return -8;
+    semaphoreInfo.semaphore = m_editorReleased;
+    if (semaphoreFd(device, &semaphoreInfo, &frame.released_fd) != VK_SUCCESS) return -9;
+    VkPhysicalDeviceIDProperties identity = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+    VkPhysicalDeviceProperties2 properties2 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2 };
+    properties2.pNext = &identity;
+    m_device->adapter()->vki()->vkGetPhysicalDeviceProperties2(m_device->adapter()->handle(), &properties2);
+    std::copy_n(identity.deviceUUID, 16, frame.device_uuid);
+    DxvkImageCreateInfo dxImage = {};
+    dxImage.type = image.imageType; dxImage.format = image.format; dxImage.extent = image.extent;
+    dxImage.numLayers = 1; dxImage.mipLevels = 1; dxImage.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    dxImage.usage = image.usage; dxImage.stages = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+    dxImage.access = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    dxImage.tiling = image.tiling; dxImage.layout = VK_IMAGE_LAYOUT_GENERAL;
+    m_editorImage = new DxvkImage(m_device.ptr(), dxImage, m_editorNativeImage);
+    DxvkImageViewCreateInfo view = {};
+    view.type = VK_IMAGE_VIEW_TYPE_2D; view.format = image.format;
+    view.usage = image.usage; view.aspect = VK_IMAGE_ASPECT_COLOR_BIT; view.numLevels = 1; view.numLayers = 1;
+    m_editorView = m_device->createImageView(m_editorImage, view);
+    SDL_HideWindow(m_window.handle());
+    return 0;
+  }
+
+  remixapi_ErrorCode RemixNativeRuntime::presentEditorFrame() {
+    m_context->externalImageBarrier(m_editorImage, true, m_editorFrameNumber == 0);
+    DxvkRenderTargets targets;
+    targets.color[0].view = m_editorView;
+    targets.color[0].layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    m_context->bindRenderTargets(targets);
+    VkClearValue clear = {}; clear.color.float32[3] = 1;
+    m_context->clearRenderTarget(m_editorView, VK_IMAGE_ASPECT_COLOR_BIT, clear);
+    m_context->getSceneManager().getLightManager().queueAutoInstancePersistent();
+    m_context->endFrame(0, m_editorImage, true);
+    m_context->onPresent(m_editorImage);
+    m_context->externalImageBarrier(m_editorImage, false, false);
+    auto commands = m_context->endRecording();
+    m_device->submitCommandList(commands, m_editorFrameNumber ? m_editorReleased : VK_NULL_HANDLE, m_editorReady);
+    // Do not advertise a frame until the ready semaphore is signaled. If this worker
+    // crashes, the editor never submits a GPU wait for work that cannot finish.
+    m_device->waitForIdle();
+    m_device->incrementPresentCount();
+    ++m_editorFrameNumber;
+    m_context->beginRecording(m_device->createCommandList());
+    return REMIXAPI_ERROR_CODE_SUCCESS;
+  }
+
+  void RemixNativeRuntime::destroyEditorFrame() {
+    m_editorView = nullptr; m_editorImage = nullptr;
+    if (m_device != nullptr) {
+      auto vk = m_device->vkd(); auto device = vk->device();
+      if (m_editorReady) vk->vkDestroySemaphore(device, m_editorReady, nullptr);
+      if (m_editorReleased) vk->vkDestroySemaphore(device, m_editorReleased, nullptr);
+      if (m_editorNativeImage) vk->vkDestroyImage(device, m_editorNativeImage, nullptr);
+      if (m_editorMemory) vk->vkFreeMemory(device, m_editorMemory, nullptr);
+    }
+    m_editorReady = VK_NULL_HANDLE; m_editorReleased = VK_NULL_HANDLE;
+    m_editorNativeImage = VK_NULL_HANDLE; m_editorMemory = VK_NULL_HANDLE; m_editorFrameNumber = 0;
+  }
