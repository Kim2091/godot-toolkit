+  // NV-DXVK start: External editor frame ownership transfer
+  void DxvkContext::externalImageBarrier(const Rc<DxvkImage>& image, bool acquire, bool firstFrame) {
+    spillRenderPass(false);
+    m_execBarriers.recordCommands(m_cmd);
+    VkImageMemoryBarrier barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    barrier.image = image->handle();
+    barrier.oldLayout = firstFrame ? VK_IMAGE_LAYOUT_UNDEFINED : VK_IMAGE_LAYOUT_GENERAL;
+    barrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    const auto family = m_device->queues().graphics.queueFamily;
+    barrier.srcQueueFamilyIndex = firstFrame ? VK_QUEUE_FAMILY_IGNORED : (acquire ? VK_QUEUE_FAMILY_EXTERNAL : family);
+    barrier.dstQueueFamilyIndex = firstFrame ? VK_QUEUE_FAMILY_IGNORED : (acquire ? family : VK_QUEUE_FAMILY_EXTERNAL);
+    barrier.srcAccessMask = acquire ? 0 : VK_ACCESS_MEMORY_WRITE_BIT;
+    barrier.dstAccessMask = acquire ? (VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT) : 0;
+    barrier.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    m_cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+    m_cmd->trackResource<DxvkAccess::Write>(image);
+  }
+  // NV-DXVK end
+
