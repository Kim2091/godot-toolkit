diff --git a/src/dxvk/rtx_render/rtx_light_usd_value.h b/src/dxvk/rtx_render/rtx_light_usd_value.h
new file mode 100644
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_light_usd_value.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include "../../util/util_vector.h"
+
+#include "../../lssusd/usd_include_begin.h"
+#include <pxr/base/gf/vec3f.h>
+#include <pxr/base/vt/value.h>
+#include "../../lssusd/usd_include_end.h"
+
+namespace dxvk {
+
+  template<typename T>
+  bool readUsdLightValue(const pxr::VtValue& value, T& output) {
+    if (!value.IsHolding<T>()) {
+      return false;
+    }
+    output = value.UncheckedGet<T>();
+    return true;
+  }
+
+  inline bool readUsdLightValue(const pxr::VtValue& value, Vector3& output) {
+    // USD color3f/float3 values hold GfVec3f, never dxvk::Vector3.
+    // Checking the renderer type rejects valid colors and leaves them white.
+    if (!value.IsHolding<pxr::GfVec3f>()) {
+      return false;
+    }
+    output = Vector3(value.UncheckedGet<pxr::GfVec3f>().data());
+    return true;
+  }
+}
