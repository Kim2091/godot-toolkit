+Error RenderingDevice::texture_copy_from_external(RID p_target, uint64_t p_image, uint64_t p_ready, uint64_t p_released) {
+	ERR_RENDER_THREAD_GUARD_V(ERR_UNAVAILABLE);
+	Texture *texture = texture_owner.get_or_null(p_target);
+	ERR_FAIL_NULL_V(texture, ERR_INVALID_PARAMETER);
+	ERR_FAIL_COND_V(!p_image || !p_ready || !p_released, ERR_INVALID_PARAMETER);
+	ERR_FAIL_COND_V(!driver->command_queue_add_external_sync(main_queue, p_ready, p_released), ERR_UNAVAILABLE);
+	struct Copy { uint64_t image; RDD::TextureID target; uint32_t width; uint32_t height; };
+	Copy *copy = memnew(Copy);
+	*copy = {p_image, texture->driver_id, texture->width, texture->height};
+	CallbackResource resource;
+	resource.rid = p_target;
+	resource.usage = CALLBACK_RESOURCE_USAGE_COPY_TO;
+	return driver_callback_add([](RDD *p_driver, RDD::CommandBufferID p_command, void *p_userdata) {
+		Copy *data = (Copy *)p_userdata;
+		p_driver->command_copy_external_texture(p_command, data->image, data->target, data->width, data->height);
+		memdelete(data);
+	}, copy, VectorView<CallbackResource>(&resource, 1));
+}
