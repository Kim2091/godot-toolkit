+bool RenderingDeviceDriverVulkan::command_queue_add_external_sync(CommandQueueID p_queue, uint64_t p_wait, uint64_t p_signal) {
+	CommandQueue *queue = (CommandQueue *)p_queue.id;
+	queue->external_waits.push_back((VkSemaphore)p_wait);
+	queue->external_signals.push_back((VkSemaphore)p_signal);
+	return true;
+}
