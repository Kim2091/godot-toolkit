[configuration]
entry_symbol = "remix_editor_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libremix_editor.so"
linux.release.x86_64 = "res://bin/libremix_editor.so"
windows.debug.x86_64 = "res://bin/remix_editor.dll"
windows.release.x86_64 = "res://bin/remix_editor.dll"
